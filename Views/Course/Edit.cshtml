@model SmartLMS.Models.Course
@{
    ViewData["Title"] = "Edit Course - Smart LMS";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-lg border-0 rounded-4 animate-up">
            <div class="card-header bg-gradient-primary text-white text-center py-4 border-0">
                <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square"></i> Modify Course Syllabus</h3>
                <p class="small mb-0 opacity-75">Update your catalog description and pricing</p>
            </div>
            
            <div class="card-body p-4 p-md-5">
                <form asp-controller="Course" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Course Title</label>
                        <input asp-for="Title" class="form-control" required placeholder="e.g. Master Software Engineering Foundations">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Course Syllabus & Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" required placeholder="Outline course syllabus, learning outcomes..."></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Course Price (in PKR / Rs.)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white fw-bold">Rs.</span>
                                <input type="number" asp-for="Price" step="0.01" class="form-control" required placeholder="e.g. 15000">
                            </div>
                            <span class="form-text text-muted small">Tuition fee represented in Pakistani Rupees.</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Category</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="Programming">Programming & IT</option>
                                <option value="Software Engineering">Software Engineering</option>
                                <option value="Database Systems">Database Systems & SQL</option>
                                <option value="Artificial Intelligence">Artificial Intelligence & Python</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-controller="Teacher" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm hover-lift"><i class="bi bi-save"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary { background: linear-gradient(135deg, #002244, #1a4270); }
</style>
