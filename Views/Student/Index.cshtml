@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_Layout";
}

<div class="row">
    <!-- Sidebar -->
    <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-white sidebar collapse shadow-sm">
        <div class="position-sticky sidebar-sticky">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link sidebar-link active" asp-controller="Student" asp-action="Index">
                        <i class="bi bi-grid-1x2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link" asp-controller="Student" asp-action="MyCourses">
                        <i class="bi bi-play-btn me-2"></i> My Courses
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link" asp-controller="Student" asp-action="Assignment">
                        <i class="bi bi-card-checklist me-2"></i> Assignments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link" asp-controller="Student" asp-action="Certificates">
                        <i class="bi bi-award me-2"></i> Certificates
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link" asp-controller="Student" asp-action="Profile">
                        <i class="bi bi-person me-2"></i> Profile
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 dashboard-main animate-up">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2 fw-bold">My Learning</h1>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <!-- Course Card -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card border-0 shadow-sm hover-lift h-100">
                    <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=500&auto=format&fit=crop&q=60" class="card-img-top" alt="Course Thumbnail" style="height: 180px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Advanced C# and .NET 8</h5>
                        <p class="card-text text-muted small">Instructor: Sarah Connor</p>
                        <div class="progress mb-2" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 45%" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-3">
                            <span>45% Complete</span>
                            <span>12/28 Lessons</span>
                        </div>
                        <a asp-controller="Student" asp-action="MyCourses" class="btn btn-primary w-100 rounded-pill">Continue Learning</a>
                    </div>
                </div>
            </div>
            
            <!-- Another Course Card -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card border-0 shadow-sm hover-lift h-100">
                    <img src="https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=500&auto=format&fit=crop&q=60" class="card-img-top" alt="Course Thumbnail" style="height: 180px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">React JS Masterclass</h5>
                        <p class="card-text text-muted small">Instructor: John Doe</p>
                        <div class="progress mb-2" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-3">
                            <span>100% Complete</span>
                            <span>Earned Certificate</span>
                        </div>
                        <a asp-controller="Student" asp-action="Certificates" class="btn btn-outline-success w-100 rounded-pill">View Certificate</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
