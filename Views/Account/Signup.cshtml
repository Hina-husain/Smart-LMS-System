@model SmartLMS.Models.ApplicationUser
@{
    ViewData["Title"] = "Sign Up";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-4 animate-up">
            <div class="card-body p-5">
                <h2 class="text-center fw-bold mb-4">Create an Account</h2>
                
                <form asp-controller="Account" asp-action="Signup" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" required placeholder="John Doe">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                            <input type="email" asp-for="Email" class="form-control" required placeholder="name@example.com">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
                            <input type="password" asp-for="PasswordHash" class="form-control" required placeholder="••••••••">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">I want to</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Student">Learn (Student)</option>
                            <option value="Teacher">Teach (Instructor)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg rounded-pill">Sign Up</button>
                </form>
                <div class="text-center mt-4">
                    <p class="mb-0">Already have an account? <a asp-action="Login" class="text-decoration-none fw-bold">Login</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
