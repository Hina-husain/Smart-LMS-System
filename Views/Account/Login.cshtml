@{
    ViewData["Title"] = "Login - Smart LMS";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 animate-up overflow-hidden">
            <!-- Branding Header -->
            <div class="card-header bg-gradient-primary text-white text-center py-4 border-0">
                <h3 class="fw-bold mb-1"><i class="bi bi-mortarboard-fill"></i> Smart LMS Portal</h3>
                <p class="small mb-0 opacity-75">Jinnah University for Women Academic Hub</p>
            </div>
            
            <div class="card-body p-4 p-md-5">
                <h4 class="text-center fw-bold mb-4 text-dark">Portal Access Sign In</h4>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Tabs to cleanly separate Student & Instructor Sign In visually -->
                <ul class="nav nav-pills mb-4 justify-content-center gap-2" id="loginTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-4 fw-bold shadow-sm" id="student-login-tab" data-bs-toggle="pill" data-bs-target="#student-form" type="button" role="tab" onclick="prefillLogin('Student')">
                            <i class="bi bi-person-fill me-1"></i> Student Portal
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 fw-bold shadow-sm" id="teacher-login-tab" data-bs-toggle="pill" data-bs-target="#teacher-form" type="button" role="tab" onclick="prefillLogin('Teacher')">
                            <i class="bi bi-briefcase-fill me-1"></i> Instructor Portal
                        </button>
                    </li>
                </ul>

                <!-- Unified Form posting to dynamic login handler -->
                <form asp-controller="Account" asp-action="Login" method="post" id="loginForm">
                    
                    <!-- Dynamic Role Indicator Badge -->
                    <div class="text-center mb-3">
                        <span id="role-badge" class="badge bg-primary text-uppercase px-3 py-2 fs-6 shadow-sm">Active View: Student Access</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-envelope-fill text-muted"></i></span>
                            <input type="email" name="email" id="login-email" class="form-control" required placeholder="student@example.com" value="student@example.com">
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-lock-fill text-muted"></i></span>
                            <input type="password" name="password" id="login-password" class="form-control" required placeholder="••••••••" value="student123">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe">
                            <label class="form-check-label text-muted small" for="rememberMe">Keep me logged in</label>
                        </div>
                        <a href="#" class="text-decoration-none small fw-bold">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg rounded-pill shadow-sm hover-lift"><i class="bi bi-box-arrow-in-right"></i> Sign In to Portal</button>
                </form>

                <div class="text-center mt-4 border-top pt-3">
                    <p class="mb-0 text-muted small">New to Jinnah University LMS? <a asp-action="Signup" class="text-decoration-none fw-bold text-primary">Create an Account</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Quick interactive pre-fill credentials helper for student/teacher
    function prefillLogin(role) {
        const emailInput = document.getElementById('login-email');
        const passInput = document.getElementById('login-password');
        const badge = document.getElementById('role-badge');

        if (role === 'Student') {
            emailInput.value = 'student@example.com';
            passInput.value = 'student123';
            emailInput.placeholder = 'student@example.com';
            badge.className = 'badge bg-primary text-uppercase px-3 py-2 fs-6 shadow-sm';
            badge.textContent = 'Active View: Student Access';
        } else {
            emailInput.value = 'teacher@example.com';
            passInput.value = 'teacher123';
            emailInput.placeholder = 'teacher@example.com';
            badge.className = 'badge bg-warning text-dark text-uppercase px-3 py-2 fs-6 shadow-sm';
            badge.textContent = 'Active View: Instructor Access';
        }
    }
</script>

<style>
    .bg-gradient-primary { background: linear-gradient(135deg, #6b21a8, #a855f7); }
    
    .nav-pills .nav-link.active {
        background-color: #6b21a8 !important;
        color: #fff !important;
    }
    
    .nav-pills .nav-link {
        color: #6b21a8;
        border: 1px solid #6b21a8;
        background-color: #fff;
    }
</style>
