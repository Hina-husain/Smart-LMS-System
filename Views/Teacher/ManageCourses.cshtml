@{
    ViewData["Title"] = "Manage My Courses";
}

<div class="container mt-5 pt-4 animate-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Manage My Courses</h2>
        <a asp-controller="Course" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Course
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course Name</th>
                            <th>Category</th>
                            <th>Enrolled Students</th>
                            <th>Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Advanced C# and .NET 10</td>
                            <td>Programming</td>
                            <td>45 Students</td>
                            <td>$99.99</td>
                            <td>
                                <a asp-controller="Course" asp-action="Details" asp-route-id="1" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> View</a>
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
